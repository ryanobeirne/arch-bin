#!/bin/bash
lass () {
	ls -alhv --color=always $@ | less -IR
}

colo () {
  for i in {30..37} {40..47}; do
    printf "\e[${i}m%s:%s\t\e[1m%s\e[7m\t%s\e[m\n" "$i" " ██ REG ██ " " ██ BOLD ██ " " ██ REVERSE ██ "
  done
}

math () {
	awk "BEGIN {PI=atan2(0, -1); print $* }"
}

say () { 
	spd-say "$*" 2> /dev/null
}

rnb () {
	cargo new --bin "$1" &&
		code "$1"
}

rnl () {
	cargo new --lib "$1" && code "$1"
}

rust () {
	temp="$(mktemp)" 
	rustc -o "$temp" <(cat <<EOF
fn main() { $@ }
EOF
	) && "$temp"
	rm "$temp"
}

precmd () {
  printf "\e]0;${0##*/}::${TTY}\7"
}

#__GPROMPT () {
	#~/repos/pretty-git-prompt/target/debug/pretty-git-prompt
#}

cowf() {
	local cowfiles=($(ls /usr/share/cows/*.cow))
	local cowfile=${cowfiles[$(( $RANDOM % ${#cowfiles[@]} ))]}
	fortune | cowsay -f "$cowfile" | lolcat
}

appendpath () {
	for p in "$@"; do
		case ":$PATH:" in
			*:"$p":*)
				;;
			*)
				[[ -d "$p" ]] && export PATH="$p:${PATH:+$PATH}"
				;;
		esac
	done
}

appendfpath () {
	for p in "$@"; do
		case ":$FPATH:" in
			*:"$p":*)
				;;
			*)
				[[ -d "$p" ]] && export FPATH="${FPATH:+$FPATH:}$p"
				;;
		esac
	done
}

ssht () {
	ssh -t "$@" 'TMUX="$(which tmux)"; tmux a || tmux'
}

lw () {
	for i in "$@"
	do
		yay -Qo $(which -a "$i")
	done
}

qu () {
	yay -Sy &&
	yay -Qu &&
	printf 'Continue system upgrade? [y/n]: ' &&
	read -q &&
	echo &&
	yay -Su --noconfirm
}

d () {
    case "$1" in
        0)
            cd .;;
        1|2|3|4|5|6|7|8|9)
            [[ -d "${dirstack[$1]}" ]] && cd "${dirstack[$1]}";;
        "")
            dirs -v | head -10;;
        *)
            return 69;;
    esac
}

define () {
    # mariadb -D english_dictionary --skip-column-names <<< "select word, wordtype, definition from entries where word = '$1';"
	curl -Ls "https://api.dictionaryapi.dev/api/v2/entries/en/$1" | jq -r 'try(.[].meanings[] | (.partOfSpeech|gsub("^";"\n")|ascii_upcase),.definitions[].definition) // .'
}

nvm () {
	unset npm_config_prefix
	export NVM_DIR=~/.nvm
	source /usr/share/nvm/nvm.sh
	source /usr/share/nvm/init-nvm.sh
	source /usr/share/nvm/install-nvm-exec
	nvm $*
}

bookmark() {
	local dir="$1"
	ln -si "$1" ~/.bookmarks/
}
