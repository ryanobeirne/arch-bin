conky.config = {
	alignment = 'top_right',
	background = false,
	border_width = 1,
	cpu_avg_samples = 2,
	default_color = 'white',
	color0 = 'white',
	color1 = '#97d8f4',
	color2 = '#808080',
	color3 = 'black',
	color4 = '#022B41',
	default_outline_color = 'white',
	default_shade_color = '#022B41',
	draw_shades = true,
	draw_borders = false,
	draw_graph_borders = true,
	draw_outline = false,
	use_xft = true,
	font = 'xos4 Terminus:size=14',
	font1 = 'xos4 Terminus:size=11',
	gap_x = 8,
	gap_y = 60,
	maximum_width = 450,
	minimum_height = 8,
	minimum_width = 8,
	net_avg_samples = 2,
	no_buffers = true,
	out_to_console = false,
	out_to_stderr = false,
	extra_newline = false,
	own_window = true,
	own_window_class = 'Conky',
	own_window_type = 'dock',
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
	own_window_transparent = true,
	own_window_argb_visual = true,
	stippled_borders = 0,
	update_interval = 1.0,
	uppercase = false,
	use_spacer = 'none',
	show_graph_scale = true,
	show_graph_range = false,
	double_buffer = true,
	text_buffer_size = 256
}

conky.text = [[
${alignc}${color1}${font xos4 Terminus:style=bold:pixelsize=36}X399M TAICHI${font}

${color1}UNIX Time: ${alignr}${color0}${utime %s}
${color1}UTC: ${alignr}${color0}${utime}
$hr
${color1}Hostname: ${alignr}${color0}$nodename
${color1}Uptime:$color ${alignr}$uptime
${color1}Kernel: ${alignr}${color0}$sysname $kernel
${color1}CPU: ${alignr}${color0}${execi 1000 cat /proc/cpuinfo | grep 'model name' | sed -e 's/model name.*: //'| uniq | cut -c 1-27}
${color1}GPU: ${scroll wait 33 ${color0}${execi 1000 lspci | grep VGA | sed 's/.*: //; s/^/+ /'}}
$hr

${color1}RAM Usage:$color $mem/$memmax
  $memperc% $color1${membar 6}
${color1}Swap Usage:$color $swap/$swapmax
  $swapperc% $color1${swapbar 6}

${color1}CPU: ${color}${cpu}% ${alignc}${freq_g}GHz ${alignr}${exec ~/bin/cputemp.sh}
$color1\
${cpubar cpu1 9,100} ${cpubar cpu2 9,100} ${cpubar cpu3 9,100} ${cpubar cpu4 9,100}
${cpubar cpu5 9,100} ${cpubar cpu6 9,100} ${cpubar cpu7 9,100} ${cpubar cpu8 9,100}
${cpubar cpu9 9,100} ${cpubar cpu10 9,100} ${cpubar cpu11 9,100} ${cpubar cpu12 9,100}
${cpubar cpu13 9,100} ${cpubar cpu14 9,100} ${cpubar cpu15 9,100} ${cpubar cpu16 9,100}
${cpubar cpu17 9,100} ${cpubar cpu18 9,100} ${cpubar cpu19 9,100} ${cpubar cpu20 9,100}
${cpubar cpu21 9,100} ${cpubar cpu22 9,100} ${cpubar cpu23 9,100} ${cpubar cpu24 9,100}
${cpubar cpu25 9,100} ${cpubar cpu26 9,100} ${cpubar cpu27 9,100} ${cpubar cpu28 9,100}
${cpubar cpu29 9,100} ${cpubar cpu30 9,100} ${cpubar cpu31 9,100} ${cpubar cpu32 9,100}
${cpugraph 60,442 022B41 97d8f4 -t}

${color1}File Systems:
$hr
${color0}root: ${font1}${color0}${fs_used /}/${fs_size /}: ${fs_free /} free${font}
  ${fs_used_perc /}% $color1${fs_bar 9 /}
${color0}home: ${font1}${color0}${fs_used /home}/${fs_size /home}: ${fs_free /home} free${font}
  ${fs_used_perc /home}% $color1${fs_bar 9 /home}
${color0}ESP: ${font1}${color0}${fs_used /boot}/${fs_size /boot}: ${fs_free /boot} free${font}
  ${fs_used_perc /boot}% $color1${fs_bar 9 /boot}
${color0}cloud: ${font1}${color0}${fs_used /home/samba/Movies}/${fs_size /home/samba/Movies}: ${fs_free /home/samba/Movies} free${font}
  ${fs_used_perc /home/samba/Movies}% $color1${fs_bar 9 /home/samba/Movies}

${color1}Network:
$hr
${color1}wlp5s0: ${scroll wait 10 ${color}${wireless_essid wlp5s0}} ${color1}|${color}${alignr}${addr wlp5s0}
${color1}Up:$color ${upspeed wlp5s0} ${alignr}${color1}Down:$color ${downspeed wlp5s0}
${upspeedgraph wlp5s0 37,217 022B41 97d8f4 -t} ${downspeedgraph wlp5s0 37,217 022B41 97d8f4 -t}
${color1}enp4s0: ${color}${alignr}${addr enp4s0}
${color1}Up:$color ${upspeed enp4s0} ${alignr}${color1}Down:$color ${downspeed enp4s0}
${upspeedgraph enp4s0 37,217 022B41 97d8f4 -t} ${downspeedgraph enp4s0 37,217 022B41 97d8f4 -t}
${color1}enp6s0: ${color}${alignr}${addr enp6s0}
${color1}Up:$color ${upspeed enp6s0} ${alignr}${color1}Down:$color ${downspeed enp6s0}
${upspeedgraph enp6s0 37,217 022B41 97d8f4 -t} ${downspeedgraph enp6s0 37,217 022B41 97d8f4 -t}


${color1}Processes:$color $processes  ${color1}Running:$color $running_processes
${color1}$hr
${color0}Name              CPU%   MEM%
${color2}\
${top name 1}${top cpu 1} ${top mem 1}
${top name 2}${top cpu 2} ${top mem 2}
${top name 3}${top cpu 3} ${top mem 3}
${top name 4}${top cpu 4} ${top mem 4}
${top name 5}${top cpu 5} ${top mem 5}

]]
